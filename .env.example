ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional. Shared secret for Zapier POST /update (CheddarUp live purchases).
# If unset, /update accepts ADMIN_PASSWORD instead.
# UPDATE_SECRET=generate-another-long-random-string

# Optional. Defaults to ./data locally.
# On Railway, attach a volume (RAILWAY_VOLUME_MOUNT_PATH is set automatically).
# DATA_DIR=/data
